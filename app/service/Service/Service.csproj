<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Antivirus.Service</RootNamespace>
    <AssemblyName>Antivirus.Service</AssemblyName>
    <UserSecretsId>antivirus-service</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- [SUA LOI CHAN PHAT HANH] Product.wxs khai <ServiceInstall> +
         <ServiceControl Start="install" Wait="yes">, tuc MSI khoi dong
         service va CHO no bao SERVICE_RUNNING cho SCM. Mot ung dung
         Microsoft.NET.Sdk.Web thuan tuy khong bao gio goi
         StartServiceCtrlDispatcher, nen SCM het thoi gian cho va tra loi
         1053 ("dich vu khong phan hoi kip thoi") -> MSI rollback -> ban cai
         KHONG BAO GIO hoan tat. Goi nay cung cap UseWindowsService(). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <!-- scan_engine.dll (C++) duoc build rieng qua app/engine/build.ps1;
       copy vao thu muc output de P/Invoke tim thay luc chay. -->
  <ItemGroup>
    <None Include="..\..\engine\build\$(Configuration)\scan_engine.dll" Condition="Exists('..\..\engine\build\$(Configuration)\scan_engine.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>scan_engine.dll</Link>
    </None>
    <None Include="..\..\engine\build\Debug\scan_engine.dll" Condition="!Exists('..\..\engine\build\$(Configuration)\scan_engine.dll') AND Exists('..\..\engine\build\Debug\scan_engine.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>scan_engine.dll</Link>
    </None>
  </ItemGroup>

</Project>
