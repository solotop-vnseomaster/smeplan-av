<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Antivirus.Shell</RootNamespace>
    <AssemblyName>AntivirusApp</AssemblyName>

    <!-- Shell doc api-token.txt truc tiep tu dia, ma file do duoc khoa ACL
         chi cho SYSTEM + Administrators. Chay quyen thuong = Access denied =
         giao dien trang. Xem giai thich day du trong app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
  </ItemGroup>

</Project>
