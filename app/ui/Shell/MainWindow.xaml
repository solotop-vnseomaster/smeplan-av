<Window x:Class="Antivirus.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SMEPlan AV — Trung tâm bảo vệ"
        Height="820" Width="1280" MinHeight="600" MinWidth="900"
        Background="#05070d"
        FontFamily="Times New Roman"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="Browser" />

        <Grid x:Name="RetryOverlay" Background="#05070d" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <TextBlock Text="Không kết nối được tới Antivirus Service"
                           Foreground="#eaf2ff" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Service nền (Antivirus.Service) có thể chưa khởi động. Hãy chạy service rồi bấm Thử lại."
                           Foreground="#9db0d0" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                <Button x:Name="RetryButton" Content="Thử lại" Click="RetryButton_Click"
                        Padding="14,8" Background="#22e5ff" Foreground="#06101f" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
